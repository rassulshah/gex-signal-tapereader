+        if (hi[i] > out.hi) { out.hi = hi[i]; out.hiSod = (int)sod[i]; }
+        if (lo[i] < out.lo) { out.lo = lo[i]; out.loSod = (int)sod[i]; }
+        any = true;
+    }
+    return any;
