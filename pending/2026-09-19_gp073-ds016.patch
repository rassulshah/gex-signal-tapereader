+// (v0.73) THE TAPE STRIP: measured, not a fixed font x 7 + 8. Strike and % strings exactly as the strip draws them, bold (the
+// King row is bold and bold is the wider face, so every row fits). Both books feed one width — the level lines and the King
+// line stop at "paneL + 2 + colW" and "paneR - colW - 2", which assumes the two strips are the same width.
+static void tapeStrings(const GStrike& s, int hideu, char* sk, size_t nsk, char* pk, size_t npk)
+{
+    if (s.spx > 0.0f) sprintf_s(sk, nsk, "%d", (int)(s.spx + 0.5f)); else sk[0] = 0;
+    sprintf_s(pk, npk, "%s%d%%", s.pct > 0 ? "+" : "", (int)(s.pct + (s.pct >= 0 ? 0.5f : -0.5f)));
+    if (std::fabs(s.pct) < (float)hideu) pk[0] = 0;
+}
+void GammaProfile::measureTape(const Settings& S)
+{
+    tapeColW = 0; tapeSpaceW = 0;
+    if (!S.tapecols) return;
+    FONT f; f.id = HELVETICA; f.size = (short)S.font; f.style = BOLD; setFont(f);
+    int spaceW = (int)getTextWidth(" ", -1), sW = 0, pW = 0; char sk[16], pk[12];
+    const std::vector<GStrike>* books[2] = { &strikes, &strikesSpy };
+    for (int b = 0; b < 2; b++) for (size_t i = 0; i < books[b]->size(); i++) {
+        tapeStrings((*books[b])[i], S.hideu, sk, sizeof(sk), pk, sizeof(pk));
+        if (sk[0]) { int w = (int)getTextWidth(sk, -1); if (w > sW) sW = w; }
+        if (pk[0]) { int w = (int)getTextWidth(pk, -1); if (w > pW) pW = w; }
+    }
+    gpl::TapeCols T = gpl::tapeCols(4, spaceW, sW, pW, gpl::TAPE_GAP_CHARS);
+    tapeColW = (short)T.colW; tapeSpaceW = (short)spaceW;
+}
+short GammaProfile::railStrikeW(const Settings& S)
+{
+    FONT f; f.id = HELVETICA; f.size = (short)S.font; f.style = BOLD; setFont(f);
+    int sW = 0; char sk[16], pk[12];
+    for (size_t i = 0; i < strikes.size(); i++) { tapeStrings(strikes[i], S.hideu, sk, sizeof(sk), pk, sizeof(pk)); if (sk[0]) { int w = (int)getTextWidth(sk, -1); if (w > sW) sW = w; } }
+    return (short)sW;
+}
